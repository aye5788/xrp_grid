# --- JSON parsing helper (fallback when state read isn't a dict) ---

_FENCE_RE = re.compile(r"^```(?:json)?\s*|\s*```$", re.MULTILINE)


def _parse_json_strict(text: str) -> Optional[dict]:
    """Strip markdown fences, find the outermost {...}, parse as JSON."""
    if not text:
        return None
    stripped = _FENCE_RE.sub("", text).strip()
    try:
        obj = json.loads(stripped)
        return obj if isinstance(obj, dict) else None
    except (ValueError, TypeError):
        pass
    start = stripped.find("{")
    end = stripped.rfind("}")
    if start != -1 and end > start:
        try:
            obj = json.loads(stripped[start:end + 1])
            return obj if isinstance(obj, dict) else None
        except (ValueError, TypeError):
            return None
    return None


# --- Alerting (Letta-step sweep removed; SDK-exception path retained) ---

def _alert_exception(agent_id: str, exc: BaseException, phase: str = "R0") -> None:
    """Record a magi_alerts row for an exception raised by the model call.

    Classifies common provider failures (auth / credit / rate limit) from the
    exception's status_code/text; defaults to provider_error/warn. Best-effort —
    never raises.
    """
    status = getattr(exc, "status_code", None)
    text = (str(exc) or "").lower()
    if status == 401 or "unauthorized" in text or "authentication" in text \
            or "api key" in text:
        category, severity = "auth_failed", "critical"
    elif status == 402 or "insufficient" in text or "quota" in text \
            or "payment required" in text or "credit" in text:
        category, severity = "credit_exhausted", "critical"
    elif status == 429 or "rate limit" in text or "rate_limit" in text:
        category, severity = "rate_limited", "warn"
    else:
        category, severity = "provider_error", "warn"
    try:
        insert_alert(
            severity=severity, category=category,
            message=f"[{phase}] {type(exc).__name__}: {exc}"[:500],
            agent_id=agent_id,
            provider_name=_MODEL_LABELS.get(agent_id),
        )
    except Exception as alert_err:
        log.error("insert_alert failed: %r", alert_err)


# --- ADK agent construction (lazy; per-agent so one bad persona can't kill all) ---

_AGENTS: dict = {}


def _get_agent(agent_id: str):
    """Build (and cache) one ADK LlmAgent. Imports ADK lazily.

    Raises on persona-load failure or missing ADK — the caller converts that into
    the agent's SAFE_DEFAULTS so a single bad agent degrades rather than crashing
    the cycle.
    """
    cached = _AGENTS.get(agent_id)
    if cached is not None:
        return cached

    from google.adk.agents import LlmAgent
    from google.adk.models.lite_llm import LiteLlm

    from magi.agents.personas import load_persona
    from magi.agents.schemas import GridVote, RegimeVote, RiskVote

    instruction = load_persona(agent_id)

    if agent_id == "casper":
        agent = LlmAgent(
            name="casper",
            model=_CASPER_MODEL,                       # native Gemini string handle
            instruction=instruction,
            include_contents="none",
            output_schema=RegimeVote,
            output_key=_OUTPUT_KEYS["casper"],
        )
    elif agent_id == "melchior":
        agent = LlmAgent(
            name="melchior",
            model=LiteLlm(model=_MELCHIOR_MODEL),       # GPT-4o via LiteLlm
            instruction=instruction,
            include_contents="none",
            output_schema=GridVote,
            output_key=_OUTPUT_KEYS["melchior"],
        )
    elif agent_id == "balthasar":
        agent = LlmAgent(
            name="balthasar",
            model=LiteLlm(model=_BALTHASAR_MODEL),      # Claude Sonnet via LiteLlm
            instruction=instruction,
            include_contents="none",
            output_schema=RiskVote,
            output_key=_OUTPUT_KEYS["balthasar"],
        )
    else:
        raise KeyError(f"unknown agent_id {agent_id!r}")

    _AGENTS[agent_id] = agent
    return agent


async def _invoke_agent_async(agent_id: str, message_text: str,
                              session_suffix: str):
    """Run one ADK agent over a fresh in-memory session and return
    (raw_state_value, final_response_text).

    Uses Runner + InMemorySessionService per the ADK runtime docs. The agent's
    structured vote lands in session.state under its output_key (raw); the final
    event text is captured as a fallback.
    """
    from google.adk.runners import Runner
    from google.adk.sessions import InMemorySessionService
    from google.genai import types

    agent = _get_agent(agent_id)
    session_service = InMemorySessionService()
    session_id = f"{agent_id}-{session_suffix}"
    await session_service.create_session(
        app_name=_APP_NAME, user_id=_USER_ID, session_id=session_id,
    )
    runner = Runner(
        agent=agent, app_name=_APP_NAME, session_service=session_service,
    )
    content = types.Content(role="user", parts=[types.Part(text=message_text)])

    final_text = None
    async for event in runner.run_async(
        user_id=_USER_ID, session_id=session_id, new_message=content,
    ):
        if (event.is_final_response() and event.content
                and event.content.parts):
            final_text = event.content.parts[0].text

    raw = None
    session = await session_service.get_session(
        app_name=_APP_NAME, user_id=_USER_ID, session_id=session_id,
    )
    if session is not None:
        raw = session.state.get(_OUTPUT_KEYS[agent_id])
    return raw, final_text


# --- Native-vote parsing + translation to the legacy parsed-vote shapes ---

def _parse_native_vote(agent_id: str, raw, final_text) -> Optional[dict]:
    """Validate the agent's structured output against its Pydantic schema and
    return the model dump, or None if nothing parseable/valid was produced."""
    from magi.agents.schemas import GridVote, RegimeVote, RiskVote
    model = {"casper": RegimeVote, "melchior": GridVote,
             "balthasar": RiskVote}[agent_id]

    obj = None
    if isinstance(raw, dict):
        obj = raw
    elif isinstance(raw, str):
        obj = _parse_json_strict(raw)
    if obj is None and final_text:
        obj = _parse_json_strict(final_text)
    if not isinstance(obj, dict):
        return None
    try:
        return model.model_validate(obj).model_dump()
    except Exception as e:
        log.warning("[%s] structured output failed schema validation: %s",
                    agent_id, e)
        return None


def _translate(agent_id: str, native: dict) -> dict:
    """Translate a validated native vote into the legacy parsed-vote dict shape
    orchestrator.py consumes. Carries `_raw` (the native dump) for R1 peer
    summaries."""
    base = {
        "conviction":     float(native.get("conviction") or 0.0),
        "key_evidence":   native.get("key_evidence") or [],
        "crux":           native.get("crux") or "",
        "freshness_retry": False,
        "freshness_mismatches": [],
        "_raw":           native,
    }
    if agent_id == "casper":
        base["position"] = native.get("position")
        base["regime_action"] = native.get("regime_action")
    elif agent_id == "balthasar":
        base["position"] = native.get("risk_action")
        base["geometry_veto"] = native.get("geometry_veto")
    elif agent_id == "melchior":
        verdict = native.get("verdict")
        base["position"] = _MELCHIOR_VERDICT_TO_ACTION.get(verdict, "MAINTAIN")
        geom = native.get("geometry")
        if verdict == "RECONFIGURE" and isinstance(geom, dict):
            base["geometry"] = {
                "target_spacing_pct": geom.get("target_spacing_pct"),
                "target_levels":      geom.get("target_levels"),
            }
        else:
            base["geometry"] = None
    return base


def _safe_default(agent_id: str, error: str) -> dict:
    """Return the agent's SAFE_DEFAULTS vote (degradation fingerprint preserved)."""
    safe = dict(SAFE_DEFAULTS[agent_id])
    safe["error"] = error
    safe["freshness_retry"] = False
    safe["freshness_mismatches"] = []
    safe["_raw"] = None
    return safe


# --- World state cache (replaces the Letta shared 'world_state' block) ---

_CURRENT_WORLD_STATE: Optional[dict] = None


def update_world_state(world_state: dict) -> None:
    """Cache the cycle's world_state for the stateless ADK agents.

    Replaces the Letta shared-block write. orchestrator calls this once per cycle;
    run_round_0_parallel (when given world_state) and run_round_1 read the cache so
    both rounds inject the same world_state into each agent's prompt. Non-fatal.
    """
    global _CURRENT_WORLD_STATE
    _CURRENT_WORLD_STATE = world_state
    try:
        n = len(world_state or {})
    except Exception:
        n = -1
    log.debug("world_state cached for cycle (%d keys)", n)


# --- Prompt/message construction (stateless; world_state injected in-message) ---

def _format_triggers_section(triggers: Optional[list]) -> str:
    """Render the TRIGGERS section that precedes the rest of the R0 message.
    Identical text for all three agents."""
    if not triggers:
        return (
            "=== NO TRIGGERS IN CURRENT WINDOW ===\n"
            "No structural events detected since the last cycle. Evaluate "
            "routine state.\n\n"
        )
    from datetime import datetime, timezone
    lines: list = []
    for t in triggers:
        tid = t.get("trigger_id", "?")
        ts = t.get("timestamp")
        details = t.get("details") or {}
        when = "?"
        if isinstance(ts, (int, float)):
            try:
                when = datetime.fromtimestamp(
                    float(ts), tz=timezone.utc
                ).strftime("%H:%M UTC")
            except Exception:
                when = "?"
        summary = json.dumps(details, default=str)[:200]
        lines.append(f"- [{tid} @ {when}] {summary}")
    body = "\n".join(lines)
    return (
        "=== TRIGGERS IN CURRENT WINDOW ===\n"
        "The following structural events occurred since the last cycle:\n"
        f"{body}\n"
        "Evaluate the current state with these events in mind, alongside the "
        "world_state below.\n\n"
    )


def _r0_message(cycle_id: str, world_state: Optional[dict]) -> str:
    """Round-0 user message: triggers + the full world_state JSON. The agent's
    persona (its instruction) plus its output_schema define the response."""
    triggers = (world_state or {}).get("triggers_since_last_cycle") or []
    ws_json = json.dumps(world_state or {}, indent=2, default=str)
    return (
        _format_triggers_section(triggers)
        + f"MAGI cycle {cycle_id} — Round 0. Evaluate the current world_state "
          f"below and render your vote per your role and output schema.\n\n"
          f"world_state:\n{ws_json}"
    )


def _peer_summary(peer_id: str, peer_vote: dict) -> str:
    """Render a peer's R0 vote in its NATIVE vocabulary for an R1 message.
    Conviction is intentionally omitted (R1 must not anchor on peer authority)."""
    raw = (peer_vote or {}).get("_raw") or {}
    ev_src = raw.get("key_evidence") or (peer_vote or {}).get("key_evidence") or []
    ev = "; ".join(str(e) for e in ev_src[:5])
    crux = raw.get("crux") or (peer_vote or {}).get("crux") or ""
    if peer_id == "casper":
        head = (f"regime={raw.get('position', (peer_vote or {}).get('position', '?'))} "
                f"regime_action={raw.get('regime_action')}")
    elif peer_id == "balthasar":
        head = (f"risk_action={raw.get('risk_action', (peer_vote or {}).get('position', '?'))} "
                f"geometry_veto={raw.get('geometry_veto')}")
    elif peer_id == "melchior":
        geom = raw.get("geometry") or {}
        head = (f"verdict={raw.get('verdict', '?')} "
                f"geometry=spacing:{geom.get('target_spacing_pct')},"
                f"levels:{geom.get('target_levels')}")
    else:
        head = "?"
    return f"[{peer_id} R0] {head}\n  key_evidence: {ev}\n  crux: {crux}"


def _r1_message(agent_id: str, cycle_id: str, world_state: Optional[dict],
                self_vote: dict, peer_votes: dict) -> str:
    """Round-1 synthesis user message: world_state + peers' native R0 votes."""
    ws_json = json.dumps(world_state or {}, indent=2, default=str)
    peer_block = "\n\n".join(
        _peer_summary(pid, pv) for pid, pv in peer_votes.items()
    )
    self_raw = (self_vote or {}).get("_raw") or {}
    self_ev = "; ".join(
        str(e) for e in (self_raw.get("key_evidence")
                         or (self_vote or {}).get("key_evidence") or [])[:5]
    )
    self_crux = self_raw.get("crux") or (self_vote or {}).get("crux") or ""
    return (
        f"MAGI cycle {cycle_id} — ROUND 1 SYNTHESIS.\n\n"
        f"Refine your vote in light of your peers' Round 0 outputs below. Stay in "
        f"your domain; re-emit your full vote per your output schema.\n\n"
        f"=== YOUR ROUND 0 ===\n"
        f"key_evidence: {self_ev}\n"
        f"crux: {self_crux}\n\n"
        f"=== PEER ROUND 0 OUTPUTS ===\n"
        f"{peer_block}\n\n"
        f"world_state:\n{ws_json}"
    )


# --- Round 0 ---

async def _send_round_0_async(agent_id: str, cycle_id: str,
                              message_text: str) -> dict:
    """Invoke one agent for Round 0, parse + translate, or SAFE_DEFAULTS."""
    try:
        raw, final_text = await _invoke_agent_async(
            agent_id, message_text, f"r0-{cycle_id}",
        )
    except Exception as e:
        log.warning("[%s] R0 invocation failed: %r", agent_id, e)
        _alert_exception(agent_id, e, phase="R0")
        return _safe_default(agent_id, f"invocation error: {e!r}")

    native = _parse_native_vote(agent_id, raw, final_text)
    if native is None:
        log.warning("[%s] R0 produced no parseable structured vote", agent_id)
        return _safe_default(agent_id, "unparseable structured output")
    return _translate(agent_id, native)


async def _round_0_async(cycle_id: str, world_state: Optional[dict]) -> dict:
    message_text = _r0_message(cycle_id, world_state)
    agents = ("casper", "melchior", "balthasar")
    coros = [_send_round_0_async(a, cycle_id, message_text) for a in agents]
    results = await asyncio.gather(*coros, return_exceptions=True)
    out: dict = {}
    for a, res in zip(agents, results):
        if isinstance(res, BaseException):
            log.exception("[%s] R0 task raised: %s", a, res)
            _alert_exception(a, res, phase="R0")
            out[a] = _safe_default(a, f"task exception: {res!r}")
        else:
            out[a] = res
    return out


def run_round_0_parallel(cycle_id: str,
                         world_state: Optional[dict] = None) -> dict:
    """Fan out Round-0 to all three agents concurrently. Returns
    {agent: parsed_vote_dict}. Each slot is a translated native vote or that
    agent's SAFE_DEFAULTS (carrying an 'error' key).

    When `world_state` is supplied it is also cached (update_world_state) so
    Round 1 can reuse it. Signature unchanged from the Letta build.
    """
    if world_state is not None:
        update_world_state(world_state)
    ws = world_state if world_state is not None else _CURRENT_WORLD_STATE
    return asyncio.run(_round_0_async(cycle_id, ws))


def send_round_0(agent_id: str, cycle_id: str,
                 world_state: Optional[dict] = None) -> dict:
    """Single-agent Round-0 convenience wrapper (compat). Returns the translated
    vote or SAFE_DEFAULTS."""
    if world_state is not None:
        update_world_state(world_state)
    ws = world_state if world_state is not None else _CURRENT_WORLD_STATE
    return asyncio.run(_send_round_0_async(agent_id, cycle_id,
                                           _r0_message(cycle_id, ws)))


# --- Conflict detection (pure logic; unchanged) ---

def detect_conflict(round_0: dict, world_state: Optional[dict] = None) -> Optional[dict]:
    """Walk CONFLICT_MATRIX against the round_0 positions and world_state.
    Returns the highest-combined-conviction matched rule, or None."""
    casper_pos    = round_0.get("casper",    {}).get("position")
    melchior_pos  = round_0.get("melchior",  {}).get("position")
    balthasar_pos = round_0.get("balthasar", {}).get("position")

    def _match(rule_val: str, actual_val) -> bool:
        return rule_val == "*" or rule_val == actual_val

    matches = []
    for regime_rule, grid_rule, risk_rule, predicate, agents, reason in CONFLICT_MATRIX:
        if not _match(regime_rule, casper_pos):
            continue
        if not _match(grid_rule, melchior_pos):
            continue
        if not _match(risk_rule, balthasar_pos):
            continue
        if predicate is not None:
            try:
                if not predicate(round_0, world_state):
                    continue
            except Exception as e:
                log.warning("conflict predicate raised: %s", e)
                continue
        a, b = agents
        combined = float(round_0.get(a, {}).get("conviction") or 0.0) + \
                   float(round_0.get(b, {}).get("conviction") or 0.0)
        matches.append((combined, {"agents": list(agents), "reason": reason}))

    if not matches:
        return None
    matches.sort(key=lambda x: x[0], reverse=True)
    return matches[0][1]


# --- Round 1 (conditional synthesis) ---

async def _send_round_1_async(agent_id: str, cycle_id: str,
                              world_state: Optional[dict],
                              self_vote: dict, peer_votes: dict) -> dict:
    """Invoke one agent for Round-1 synthesis, parse + translate, or return an
    {_r1_parse_error: ...} marker (caller falls back to R0)."""
    message_text = _r1_message(agent_id, cycle_id, world_state,
                               self_vote, peer_votes)
    try:
        raw, final_text = await _invoke_agent_async(
            agent_id, message_text, f"r1-{cycle_id}",
        )
    except Exception as e:
        log.warning("[%s] R1 invocation failed: %r", agent_id, e)
        _alert_exception(agent_id, e, phase="R1")
        return {"_r1_parse_error": f"invocation error: {e!r}"}

    native = _parse_native_vote(agent_id, raw, final_text)
    if native is None:
        log.warning("[%s] R1 produced no parseable structured vote", agent_id)
        return {"_r1_parse_error": "unparseable structured output"}
    return _translate(agent_id, native)


async def _round_1_async(round_0: dict, cycle_id: str,
                         world_state: Optional[dict]) -> dict:
    agents = ("casper", "melchior", "balthasar")
    coros = []
    for a in agents:
        self_vote = round_0.get(a) or {}
        peers = {p: (round_0.get(p) or {}) for p in agents if p != a}
        coros.append(_send_round_1_async(a, cycle_id, world_state,
                                         self_vote, peers))
    results = await asyncio.gather(*coros, return_exceptions=True)
    out: dict = {}
    for a, res in zip(agents, results):
        if isinstance(res, BaseException):
            log.exception("[%s] R1 task raised: %s", a, res)
            out[a] = {"_r1_parse_error": f"task exception: {res!r}"}
        else:
            out[a] = res
    return out


def run_round_1(round_0: dict, cycle_id: str) -> dict:
    """Synthesis round: send R1 to all three agents concurrently. Each agent's
    R1 user message pastes the OTHER two agents' R0 votes (native vocabulary).
    Returns {agent: parsed_r1_vote | {_r1_parse_error: ...}}. World_state is read
    from the per-cycle cache (set by update_world_state / run_round_0_parallel).
    Signature unchanged from the Letta build."""
    return asyncio.run(_round_1_async(round_0, cycle_id, _CURRENT_WORLD_STATE))


def send_round_1_synthesis(agent_id: str, cycle_id: str,
                           self_r0: dict, peer_r0s: dict) -> dict:
    """Single-agent Round-1 convenience wrapper (compat)."""
    return asyncio.run(_send_round_1_async(agent_id, cycle_id,
                                           _CURRENT_WORLD_STATE,
                                           self_r0 or {}, peer_r0s or {}))


# --- R1 novelty gate (pure logic; unchanged) ---

def _r0_conflict(round_0: dict) -> tuple:
    """Genuine cross-agent disagreement in the R0 votes that an R1 synthesis pass
    could productively resolve. Returns (conflict: bool, reason: str)."""
    casper    = round_0.get("casper")    or {}
    melchior  = round_0.get("melchior")  or {}
    balthasar = round_0.get("balthasar") or {}

    grid          = melchior.get("position")
    risk          = balthasar.get("position")
    regime        = casper.get("position")
    regime_action = casper.get("regime_action")
    geometry_veto = balthasar.get("geometry_veto")
    structural    = grid in ("RECENTRE", "TIGHTEN", "WIDEN")

    if structural:
        if regime_action in ("DEFER_STRUCTURAL", "STAND_DOWN"):
            return True, f"{grid} opposed by casper regime_action={regime_action}"
        if geometry_veto in ("HOLD_GEOMETRY", "RISK_BLOCK"):
            return True, f"{grid} opposed by balthasar geometry_veto={geometry_veto}"
        if risk in ("HALT", "PAUSE_LONGS", "PAUSE_SHORTS"):
            return True, f"{grid} opposed by balthasar risk={risk}"

    if regime == "TRENDING" and grid == "TIGHTEN":
        return True, "TIGHTEN into TRENDING regime"
    if grid == "WIDEN" and risk in ("PAUSE_LONGS", "PAUSE_SHORTS"):
        return True, f"WIDEN while {risk}"
    try:
        balt_conv = float(balthasar.get("conviction") or 0.0)
    except (TypeError, ValueError):
        balt_conv = 0.0
    if risk == "HALT" and balt_conv > 0.6:
        return True, f"balthasar HALT conv={balt_conv:.2f} vs live grid"

    return False, "council aligned on action"


def r0_position_signature(round_0: dict) -> tuple:
    """Comparable fingerprint of the cycle's R0 stance — the three domain
    positions an R1 synthesis would reconcile. Order matches
    orchestrator._prior_r0_signature (casper, melchior, balthasar)."""
    return (
        (round_0.get("casper")    or {}).get("position"),
        (round_0.get("melchior")  or {}).get("position"),
        (round_0.get("balthasar") or {}).get("position"),
    )


def should_run_r1(round_0: dict,
                  prior_signature: Optional[tuple] = None) -> tuple:
    """Gate the R1 synthesis pass. Fires iff the R0 votes carry a genuine conflict
    AND the R0 position signature differs from the previous cycle's. Returns
    (fire, reason)."""
    conflict, why = _r0_conflict(round_0)
    if not conflict:
        return False, f"skip: {why}"
    cur = r0_position_signature(round_0)
    if prior_signature is not None and tuple(prior_signature) == cur:
        return False, f"skip: conflict unchanged from prior cycle ({why})"
    return True, f"fire: {why}"


# --- Revision validity + consensus (pure logic; unchanged) ---

_NUM_RE  = re.compile(r"\b\d+\.?\d*\b")
_WORD_RE = re.compile(r"[A-Za-z]+")


def validate_revision(round_0_evidence: list, revision_evidence: str) -> tuple[bool, str]:
    """Decide whether a Round-1 revision is 'real' or capitulation."""
    if not isinstance(revision_evidence, str) or len(revision_evidence) < 20:
        return False, "revision_evidence shorter than 20 chars"

    joined_r0 = " ".join(round_0_evidence or []) if round_0_evidence else ""
    joined_r0_lower = joined_r0.lower()

    r0_nums = set(_NUM_RE.findall(joined_r0))
    rev_nums = set(_NUM_RE.findall(revision_evidence))
    novel_nums = rev_nums - r0_nums
    if novel_nums:
        return True, f"novel numeric values: {sorted(novel_nums)}"

    rev_words = [w.lower() for w in _WORD_RE.findall(revision_evidence) if len(w) > 4]
    r0_words = {w.lower() for w in _WORD_RE.findall(joined_r0_lower) if len(w) > 4}
    novel_words = [w for w in rev_words if w not in r0_words]
    distinct_novel = list(dict.fromkeys(novel_words))
    if len(distinct_novel) >= 3:
        return True, f"novel words: {distinct_novel[:5]}"

    return False, "no novel numeric values and < 3 novel long words (capitulation)"


def _most_conservative_risk(positions: list) -> str:
    """Pick the most conservative balthasar risk action from candidates."""
    best = None
    best_rank = -1
    for p in positions:
        rank = _RISK_CONSERVATISM_ORDER.get(p, -1)
        if rank > best_rank:
            best_rank = rank
            best = p
    return best or "CLEAR"


def _final_per_agent(round_0: dict, round_1: dict, agent_id: str) -> dict:
    """Return the agent's FINAL R1-or-R0 vote. Prefers R1 when parseable; falls
    back to R0 on R1 parse failure."""
    r1 = (round_1 or {}).get(agent_id) or {}
    if r1 and not r1.get("_r1_parse_error"):
        return r1
    return (round_0 or {}).get(agent_id) or {}


def _safe_extension(agent_final: dict, key: str,
                    allowed: tuple, default: str) -> str:
    """Read an extension field permissively. Missing or unknown -> default."""
    v = agent_final.get(key)
    if isinstance(v, str) and v in allowed:
        return v
    return default


def resolve_consensus(round_0: dict, round_1: Optional[dict],
                      conflict: Optional[dict] = None) -> dict:
    """Synthesis consensus. Each agent's FINAL vote = its R1 if parseable, else
    its R0. Adds regime_action (Casper) and geometry_veto (Balthasar), both read
    by enforce_hard_rules downstream. Shape unchanged from the Letta build."""
    casper_final    = _final_per_agent(round_0, round_1 or {}, "casper")
    melchior_final  = _final_per_agent(round_0, round_1 or {}, "melchior")
    balthasar_final = _final_per_agent(round_0, round_1 or {}, "balthasar")

    grid_action = melchior_final.get("position") or "MAINTAIN"
    risk_action = balthasar_final.get("position") or "CLEAR"
    regime      = casper_final.get("position") or "UNCERTAIN"
    regime_action = _safe_extension(
        casper_final, "regime_action", REGIME_ACTIONS, "EXECUTE",
    )
    geometry_veto = _safe_extension(
        balthasar_final, "geometry_veto", GEOMETRY_VETOS, "PROCEED",
    )

    r1_shifts = []
    for a in ("casper", "melchior", "balthasar"):
        r0_pos = (round_0.get(a) or {}).get("position")
        r1_pos = ((round_1 or {}).get(a) or {}).get("position")
        if (r1_pos and r0_pos and r1_pos != r0_pos):
            r1_shifts.append(f"{a}: {r0_pos}->{r1_pos}")
    debate_triggered = bool(r1_shifts)

    r1_errors = {
        a: ((round_1 or {}).get(a) or {}).get("_r1_parse_error")
        for a in ("casper", "melchior", "balthasar")
    }
    r1_errors = {k: v for k, v in r1_errors.items() if v}

    if r1_shifts:
        reasoning = "R1 synthesis shifted: " + "; ".join(r1_shifts)
    else:
        reasoning = "R1 synthesis — all positions held"
    if r1_errors:
        reasoning += (f" (R1 parse errors: {list(r1_errors)} — "
                      f"fell back to R0 for those)")

    return {
        "grid_action":      grid_action,
        "risk_action":      risk_action,
        "regime":           regime,
        "regime_action":    regime_action,
        "geometry_veto":    geometry_veto,
        "debate_triggered": debate_triggered,
        "deadlock":         False,
        "reasoning":        reasoning,
    }


